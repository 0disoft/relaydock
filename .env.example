# Host-provided per-user runtime directory used for Unix-domain sockets.
# Normally systemd/login sets this; leave empty to use the application fallback.
XDG_RUNTIME_DIR=

# Shared process defaults
ARG_ENVIRONMENT=development
ARG_HTTP_ADDRESS=127.0.0.1:8080
ARG_HTTP_READ_TIMEOUT=15s
ARG_HTTP_WRITE_TIMEOUT=0s
ARG_HTTP_IDLE_TIMEOUT=90s
ARG_HTTP_SHUTDOWN_TIMEOUT=15s
ARG_HTTP_MAX_BODY_BYTES=8388608

# PostgreSQL and Valkey
ARG_POSTGRES_URL=postgres://airuntime:airuntime@127.0.0.1:5432/airuntime?sslmode=disable
DATABASE_URL=
ARG_VALKEY_ADDRESS=127.0.0.1:6379
ARG_VALKEY_USERNAME=
ARG_VALKEY_PASSWORD=

# Optional object-store adapter settings
ARG_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
ARG_OBJECT_STORE_BUCKET=airuntime-dev
ARG_OBJECT_STORE_REGION=local

# Gateway HTTP service
GATEWAY_ADDRESS=127.0.0.1:8080
GATEWAY_BEARER_TOKEN=
GATEWAY_POSTGRES_URL=
GATEWAY_VIRTUAL_KEY_PEPPER=
GATEWAY_VIRTUAL_KEY_PEPPER_B64=
GATEWAY_KEY_ENVIRONMENT=live
# Set after replacing placeholder model IDs in config/gateway-routes.example.json.
GATEWAY_ROUTES_FILE=
GATEWAY_ROUTES_JSON=
GATEWAY_DEFAULT_PROVIDER=
# Empty defaults to true only when no real provider is configured. Production
# should set false explicitly so the mock route cannot appear beside paid models.
GATEWAY_ENABLE_LOCAL_ECHO=
# Empty defaults to false when GATEWAY_CONTROL_URL is configured, otherwise true.
# Keep false in signed-control deployments so provider/model cannot bypass routes.
GATEWAY_ALLOW_DIRECT_MODELS=
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_PROVIDER_LEASE_TTL=2m
GATEWAY_RETRY_BASE_DELAY=250ms
GATEWAY_RETRY_MAX_DELAY=5s
GATEWAY_VALKEY_URL=
GATEWAY_VALKEY_ADDRESS=
GATEWAY_VALKEY_PREFIX=arg

# Request/attempt journal. PostgreSQL mode requires migrated runtime/outbox schemas.
GATEWAY_RUNTIME_JOURNAL=disabled
GATEWAY_RUNTIME_JOURNAL_TIMEOUT=5s
GATEWAY_PRICE_REVISION_ID=unpriced
# Required when PostgreSQL journaling can receive operator-bearer or unauthenticated loopback traffic.
GATEWAY_OPERATOR_TENANT_ID=
GATEWAY_OPERATOR_PROJECT_ID=
GATEWAY_OPERATOR_VIRTUAL_KEY_ID=

# Optional signed Control Plane synchronization. Obtain the public key with:
#   go run ./cmd/controlctl signing-key --raw
GATEWAY_CONTROL_URL=
GATEWAY_CONTROL_BEARER_TOKEN=
GATEWAY_CONTROL_SIGNING_PUBLIC_KEY=
GATEWAY_CONTROL_SIGNING_PUBLIC_KEY_B64=
# Optional explicit ID for the primary key. Additional trusted keys accept a JSON
# array or comma-separated id=base64 entries during zero-downtime rotation.
GATEWAY_CONTROL_SIGNING_KEY_ID=
GATEWAY_CONTROL_TRUSTED_SIGNING_PUBLIC_KEYS=
GATEWAY_CONTROL_ALLOW_LEGACY_SIGNING_KEY_ID=true
GATEWAY_CONTROL_REQUIRED=false
GATEWAY_CONTROL_LKG_PATH=data/gateway/runtime-snapshot.json
GATEWAY_CONTROL_MAX_SNAPSHOT_BYTES=33554432
GATEWAY_CONTROL_MAX_FUTURE_SKEW=5m

# Control-plane HTTP service. local is suitable for one process; postgres is
# required when multiple control-plane replicas must share immutable revisions.
CONTROL_ADDRESS=127.0.0.1:8081
# Legacy single token maps to cluster admin. Prefer CONTROL_ACCESS_TOKENS_JSON.
CONTROL_BEARER_TOKEN=
# Strict JSON array of SHA-256 token digests and principals. Raw tokens stay in
# client secret stores. Roles: gateway, viewer, publisher, admin.
CONTROL_ACCESS_TOKENS_JSON=
CONTROL_SNAPSHOT_STORE=local
CONTROL_STATE_PATH=data/control/snapshot.json
CONTROL_POSTGRES_URL=
CONTROL_POSTGRES_OPEN_TIMEOUT=15s
CONTROL_SNAPSHOT_POLL_INTERVAL=2s
# Secret-manager injection accepts a base64/base64url Ed25519 seed or private key.
# Leave empty to load or create CONTROL_SIGNING_KEY_PATH.
CONTROL_SIGNING_PRIVATE_KEY=
CONTROL_SIGNING_KEY_PATH=data/control/signing.key
CONTROL_SIGNING_KEY_ID=
# Keep the retiring public key here while old snapshots remain in circulation.
CONTROL_TRUSTED_SIGNING_PUBLIC_KEYS=
CONTROL_ALLOW_LEGACY_SIGNING_KEY_ID=true
CONTROL_API_BASE_URL=http://127.0.0.1:8081

# Expert broker and Remote MCP
EXPERT_BROKER_ADDRESS=127.0.0.1:8082
EXPERT_BROKER_BEARER_TOKEN=
# Legacy static bearer remains available for local compatibility. New remote
# deployments should issue scoped tokens with mcptokenctl instead. Once a scoped
# token secret exists, broker-token reuse defaults to false and must never be
# enabled accidentally in a multi-tenant deployment.
EXPERT_MCP_BEARER_TOKEN=
EXPERT_MCP_ALLOW_BROKER_TOKEN=
EXPERT_MCP_TOKEN_SECRET=
EXPERT_MCP_TOKEN_SECRET_B64=
# argt2 tokens carry this key ID. If empty, a stable ID is derived from the secret.
EXPERT_MCP_TOKEN_KEY_ID=
# JSON object of retiring key IDs to base64 secrets, for example
# {"2026-q2":"<base64-secret>"}. Remove after every issued token has expired.
EXPERT_MCP_TOKEN_VERIFICATION_KEYS_B64=
# argt1 has no key ID. Leave enabled only through the migration window.
EXPERT_MCP_TOKEN_ALLOW_LEGACY=true
EXPERT_MCP_TOKEN_AUDIENCE=expert-mcp
EXPERT_MCP_TOKEN_MAX_LIFETIME=24h
EXPERT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
EXPERT_MCP_ALLOWED_ORIGINS=
EXPERT_STATE_PATH=data/expert-broker/state.json
EXPERT_POSTGRES_URL=
EXPERT_TENANT_ID=
EXPERT_PROJECT_ID=

# Expert worker. It starts only when OPENAI_API_KEY and EXPERT_MODEL are both set.
EXPERT_MODEL=
EXPERT_REASONING_MODE=pro
EXPERT_REASONING_EFFORT=max
EXPERT_MAX_OUTPUT_TOKENS=8192
EXPERT_WORKER_ID=
EXPERT_WORKER_CONCURRENCY=1
EXPERT_WORKER_MAX_ATTEMPTS=3
EXPERT_WORKER_POLL_INTERVAL=500ms
EXPERT_WORKER_LEASE_TTL=2m
EXPERT_WORKER_RENEW_INTERVAL=40s
EXPERT_WORKER_RETRY_BASE_DELAY=2s
EXPERT_WORKER_RETRY_MAX_DELAY=2m
EXPERT_INPUT_PER_MILLION_MINOR=
EXPERT_OUTPUT_PER_MILLION_MINOR=
EXPERT_REASONING_PER_MILLION_MINOR=

# Transactional outbox webhook delivery
OUTBOX_POSTGRES_URL=
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
OUTBOX_WEBHOOK_SECRET_B64=
OUTBOX_WEBHOOK_HEADERS_JSON=
OUTBOX_ALLOW_INSECURE_HTTP=false
OUTBOX_WORKER_ID=
OUTBOX_BATCH_SIZE=32
OUTBOX_CONCURRENCY=4
OUTBOX_LEASE_TTL=1m
OUTBOX_POLL_INTERVAL=1s
OUTBOX_PUBLISH_TIMEOUT=30s
OUTBOX_REPOSITORY_TIMEOUT=10s
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=15m
OUTBOX_RETRY_JITTER_RATIO=0.2
OUTBOX_HEALTH_ADDRESS=127.0.0.1:8083
OUTBOX_BEARER_TOKEN=

# Reference webhook consumer used only for local contract tests
WEBHOOK_SINK_ADDRESS=127.0.0.1:8090
WEBHOOK_SINK_BEARER_TOKEN=
WEBHOOK_SINK_SECRET=
WEBHOOK_SINK_SECRET_B64=
WEBHOOK_SINK_MAX_BODY_BYTES=2097152

# Desktop and headless local runtime
ARG_DESKTOP_DATA_DIR=
ARG_DESKTOP_IPC_NAME=relaydock
ARG_DESKTOP_SETTINGS_PATH=
ARG_DESKTOP_START_MINIMIZED=false
ARG_DEFAULT_REPOSITORY_ROOT=

# Official provider credentials and optional endpoint overrides
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_LANGUAGE_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=RelayDock
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Destructive PostgreSQL integration test. Use a disposable database only.
ARG_TEST_POSTGRES_URL=
ARG_TEST_POSTGRES_ALLOW_RESET=
