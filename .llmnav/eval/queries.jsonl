{"query":"apply rollback or inspect the embedded PostgreSQL migration sequence","expected":["relaydock.command.dbmigrate"]}
{"query":"start the asynchronous expert consultation broker and optional remote MCP endpoint","expected":["relaydock.command.expert-brokerd"]}
{"query":"verify compact or inspect statistics for the local expert consultation store","expected":["relaydock.command.expertstorectl"]}
{"query":"start the authenticated provider routing accounting and runtime AI gateway process","expected":["relaydock.command.gatewayd"]}
{"query":"run the persistent local runtime over IPC without the desktop interface","expected":["relaydock.command.headless"]}
{"query":"issue or revoke a project scoped gateway virtual key from the operator CLI","expected":["relaydock.command.keyctl"]}
{"query":"start the MCP stdio process that connects tools to the local RelayDock runtime","expected":["relaydock.command.mcp-bridge"]}
{"query":"issue a bounded expert MCP bearer token with consultation scopes","expected":["relaydock.command.mcptokenctl"]}
{"query":"list and requeue outbox dead letters or purge old published events","expected":["relaydock.command.outboxctl"]}
