{
  "name": "relaydock",
  "private": true,
  "version": "0.5.11-dev",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "web/control-console"
  ],
  "trustedDependencies": [],
  "scripts": {
    "desktop:dev": "bun run --cwd frontend dev",
    "desktop:build": "bun run --cwd frontend build",
    "control:dev": "bun run --cwd web/control-console dev",
    "control:build": "bun run --cwd web/control-console build",
    "llmnav:audit": "llmnav audit --fail-on high",
    "llmnav:check": "llmnav check",
    "llmnav:format": "llmnav format",
    "llmnav:generate": "llmnav generate",
    "llmnav:eval": "llmnav eval"
  },
  "devDependencies": {
    "llmnav": "^0.7.2"
  }
}
