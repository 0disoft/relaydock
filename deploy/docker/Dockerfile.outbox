FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/your-org/ai-runtime-gateway/internal/buildinfo.Version=${VERSION} -X github.com/your-org/ai-runtime-gateway/internal/buildinfo.Commit=${COMMIT}" \
    -o /out/outboxd ./cmd/outboxd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/outboxd /outboxd
USER nonroot:nonroot
ENTRYPOINT ["/outboxd"]
