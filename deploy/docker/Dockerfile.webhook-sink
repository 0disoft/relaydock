FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOFLAGS=-mod=readonly
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/0disoft/relaydock/internal/buildinfo.Version=${VERSION} -X github.com/0disoft/relaydock/internal/buildinfo.Commit=${COMMIT}" \
    -o /out/webhook-sink ./cmd/webhook-sink

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/webhook-sink /webhook-sink
USER nonroot:nonroot
ENTRYPOINT ["/webhook-sink"]
