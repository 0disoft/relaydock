FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOFLAGS=-mod=readonly
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/0disoft/relaydock/internal/buildinfo.Version=${VERSION} -X github.com/0disoft/relaydock/internal/buildinfo.Commit=${COMMIT} -X github.com/0disoft/relaydock/internal/buildinfo.BuildTime=${BUILD_TIME}" \
    -o /out/gatewayd ./cmd/gatewayd \
    && mkdir -p /out/state/gateway

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="RelayDock Gateway" \
      org.opencontainers.image.source="https://github.com/0disoft/relaydock" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"
COPY --from=build /out/gatewayd /gatewayd
COPY --from=build --chown=65532:65532 /out/state /var/lib/ai-runtime
ENV GATEWAY_CONTROL_LKG_PATH=/var/lib/ai-runtime/gateway/runtime-snapshot.json
USER nonroot:nonroot
ENTRYPOINT ["/gatewayd"]
